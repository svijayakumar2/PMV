#BSUB -o /u/saranyaibm2/.lsbatch/%J.out
#BSUB -e /u/saranyaibm2/.lsbatch/%J.err
#BSUB -W 72:00

set -euo pipefail

PROJECT_DIR=/dccstor/principled_ai/users/saranyaibm2/xor
CACHE_DIR=/dccstor/principled_ai/users/saranyaibm2/hf_cache
VENV_DIR=${PROJECT_DIR}/.venv
TS=$(date +%Y%m%d_%H%M%S)
OUTPUT_ROOT=${PROJECT_DIR}/outputs/family_pipeline/cnf_dnf/${TS}
SEEDS="${SEEDS:-41}"
EXECUTE=1
TASKS="${TASKS:-3cnf_28d,3dnf_28d}"

# Tuned for clause-structured CNF/DNF proposer + formula-pool verifier.
TRAIN_TASKS=120000
TRAIN_EVAL_TASKS=${VAL_TASKS:-1000}
BATCH_SIZE=128
EPOCHS=50
VAL_TASKS=${VAL_TASKS:-1000}
FINAL_TASKS=${FINAL_TASKS:-3000}

export HF_HOME="${CACHE_DIR}"
export TRANSFORMERS_CACHE="${CACHE_DIR}"
export HF_DATASETS_CACHE="${CACHE_DIR}"

cd "${PROJECT_DIR}"
mkdir -p "${CACHE_DIR}" "${OUTPUT_ROOT}"

if [ ! -d "${VENV_DIR}" ]; then
  python3 -m venv "${VENV_DIR}"
fi
source "${VENV_DIR}/bin/activate"
python3 -m pip install --upgrade pip
if [ -f "requirements.txt" ]; then
  python3 -m pip install -r requirements.txt
fi

echo "Job started: $(date)"
echo "Host: $(hostname)"
echo "Job ID: ${LSB_JOBID:-unknown}"
echo "Output root: ${OUTPUT_ROOT}"


