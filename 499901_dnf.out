# LSBATCH: User input
#!/bin/bash
#BSUB -J xor_family_cnf_dnf
#BSUB -q normal
#BSUB -gpu "num=1:mode=exclusive_process:gmodel=NVIDIAA100_SXM4_80GB"
#BSUB -M 80GB
